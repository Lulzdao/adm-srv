# Скопируйте в .env и заполните реальными значениями. .env в git не коммитить.

PORT=3000
SESSION_SECRET=замените-на-случайную-строку

DB_PATH=./data/helpdesk.db
UPLOADS_DIR=./uploads

# --- Домен А ---
DOMAIN_A_LABEL=Домен А
DOMAIN_A_LDAP_URL=ldaps://dc1.domain-a.local:636
DOMAIN_A_BASE_DN=DC=domain-a,DC=local
# формат: либо UPN (user@domain-a.local), либо через сервисную учётку + поиск по sAMAccountName
DOMAIN_A_SVC_DN=CN=svc-helpdesk,OU=Service Accounts,DC=domain-a,DC=local
DOMAIN_A_SVC_PASSWORD=
DOMAIN_A_ADMIN_GROUP=Lipetskstat-IT

# --- Домен Б ---
DOMAIN_B_LABEL=Домен Б
DOMAIN_B_LDAP_URL=ldaps://dc1.domain-b.local:636
DOMAIN_B_BASE_DN=DC=domain-b,DC=local
DOMAIN_B_SVC_DN=CN=svc-helpdesk,OU=Service Accounts,DC=domain-b,DC=local
DOMAIN_B_SVC_PASSWORD=
DOMAIN_B_ADMIN_GROUP=IT-Otdel-B

# TLS: приложение запускается с флагом --use-system-ca (см. package.json),
# который заставляет Node.js доверять сертификатам из хранилища Windows —
# этого обычно достаточно для внутреннего сертификата AD CS, если сервер
# в домене и сертификат уже есть в его доверенных корневых. Если после
# этого сертификат всё равно не проходит проверку (node scripts/test-ldap.js
# покажет UNABLE_TO_VERIFY_LEAF_SIGNATURE) — экспортируйте корневой/промежуточный
# сертификат AD CS в .pem и укажите путь в NODE_EXTRA_CA_CERTS ниже.
NODE_EXTRA_CA_CERTS=

# Отключение проверки сертификата совсем — только для разового теста,
# никогда не оставлять так на постоянной основе:
LDAP_TLS_REJECT_UNAUTHORIZED=true

# --- Локальный аварийный вход (на случай недоступности обоих доменов) ---
# Логин ОБЯЗАТЕЛЬНО начинается с "!" — по этому символу фронтенд отличает
# локальный вход от доменного, не пытаясь искать такой логин в LDAP.
LOCAL_ADMIN_LOGIN=!admin
LOCAL_ADMIN_PASSWORD_HASH=
# Общая аварийная учётка без прав администратора
LOCAL_USER_LOGIN=!user
LOCAL_USER_PASSWORD_HASH=

# --- Автоопределение домена по подсети клиента (вместо вкладок на логине) ---
NETWORK_DOMAIN_A_CIDR=10.148.12.0/22
NETWORK_DOMAIN_B_CIDR=192.168.254.0/23

# Сколько дней сессия остаётся активной без повторного входа (продлевается
# при каждом заходе — "rolling"). Это не настоящий SSO, а длинная сессия.
SESSION_MAX_AGE_DAYS=30

# --- Почта (Yandex 360/Почта для домена или др., внешняя аутентификация) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Служба заявок <helpdesk@lipetskstat.ru>"
