# Скопируйте в .env и заполните реальными значениями. .env в git не коммитить.

PORT=3000
SESSION_SECRET=замените-на-случайную-строку

# --- HTTPS ---
# Шифрование включается само, как только задан сертификат — отдельного
# переключателя нет, чтобы не было состояния «сертификат положили, а включить
# забыли». Ничего не задано — платформа работает по http и предупреждает об
# этом в консоли. Обратного прокси перед приложением нет намеренно: так не
# остаётся параллельного незашифрованного порта, про который легко забыть.
#
# По умолчанию сертификаты берутся из ОБЩЕГО хранилища, которым управляет панель
# «Искры» (MESSENGER/certs/): сервисы стоят на одной машине, поэтому хранилище у
# них одно. Платформа перечитывает файлы сама, без перезапуска. Тогда ничего
# заполнять здесь не нужно.
#
# ДВА ДОМЕНА — ДВА СЕРТИФИКАТА. Подсети две, удостоверяющий центр в каждой свой.
# Класть в хранилище по файлу на домен, сервер отдаст тот, чьё имя запросил
# клиент (SNI):
#   server.pfx            — основной, rosstat.local (он же уедет незнакомым именам)
#   server.in.local.pfx   — второй домен; суффикс в имени файла произвольный,
#                           реальные имена читаются из самого сертификата
#   server*.pass          — пароль к соседнему .pfx, если он есть
# Так клиент из любой подсети видит сертификат СВОЕГО домена, и заставлять один
# домен доверять чужому УЦ не нужно. Кто за какое имя отвечает — видно в разделе
# «Сертификаты» панели, там же проверка «что увидит клиент с именем …».
#
# Путь к общему хранилищу, если оно лежит не рядом:
SHARED_CERT_DIR=
#
# Вариант 1 — задать сертификат явно, PFX из УЦ домена (экспортировать вместе с
# закрытым ключом и всеми сертификатами пути). Имеет приоритет над общим
# хранилищем и отключает и слежение за каталогом, и выбор по имени: сертификат
# станет один на оба домена.
TLS_PFX=
TLS_PFX_PASSWORD=
#
# Вариант 2 — PEM. TLS_CERT обязательно ПОЛНАЯ цепочка
# (cat server.crt chain.crt > fullchain.crt), ключ — без пароля:
TLS_CERT=
TLS_KEY=
#
# --- Доверенные корни (кому доверяет САМА платформа) ---
# Обычно не нужны: приложение запускается с --use-system-ca и доверяет
# хранилищу Windows, куда корни обоих доменов приезжают групповыми политиками.
# Каталог со своими корнями (их видно и правит раздел «Сертификаты» в панели);
# чтобы они действительно применились, каталог указывают в NODE_EXTRA_CA_CERTS
# и перезапускают платформу.
TRUSTED_CA_DIR=
NODE_EXTRA_CA_CERTS=
#
# Важно про модули за HTTPS (сейчас это «Искра»): платформа проверяет их
# сертификат по-настоящему, поэтому в config/modules.js модуль должен быть
# адресован ИМЕНЕМ из его сертификата, а не по 127.0.0.1. Переопределить
# адрес, не трогая код:
MODULE_MESSENGER_URL=

DB_PATH=./data/helpdesk.db
UPLOADS_DIR=./uploads

# --- Домен А ---
DOMAIN_A_LABEL=Домен А
DOMAIN_A_LDAP_URL=ldaps://dc1.domain-a.local:636
DOMAIN_A_BASE_DN=DC=domain-a,DC=local
# формат: либо UPN (user@domain-a.local), либо через сервисную учётку + поиск по sAMAccountName
DOMAIN_A_SVC_DN=CN=svc-helpdesk,OU=Service Accounts,DC=domain-a,DC=local
DOMAIN_A_SVC_PASSWORD=
DOMAIN_A_ADMIN_GROUP=Lipetskstat-IT

# --- Домен Б ---
DOMAIN_B_LABEL=Домен Б
DOMAIN_B_LDAP_URL=ldaps://dc1.domain-b.local:636
DOMAIN_B_BASE_DN=DC=domain-b,DC=local
DOMAIN_B_SVC_DN=CN=svc-helpdesk,OU=Service Accounts,DC=domain-b,DC=local
DOMAIN_B_SVC_PASSWORD=
DOMAIN_B_ADMIN_GROUP=IT-Otdel-B

# TLS для LDAPS: приложение запускается с флагом --use-system-ca (см.
# package.json), который заставляет Node.js доверять сертификатам из хранилища
# Windows — этого обычно достаточно для внутреннего сертификата AD CS, если
# сервер в домене и корень уже приехал групповыми политиками. Если проверка
# всё равно не проходит (node scripts/test-ldap.js покажет
# UNABLE_TO_VERIFY_LEAF_SIGNATURE) — добавьте корень AD CS в раздел
# «Сертификаты» панели и пропишите NODE_EXTRA_CA_CERTS выше.
#
# Отключение проверки сертификата совсем — только для разового теста,
# никогда не оставлять так на постоянной основе:
LDAP_TLS_REJECT_UNAUTHORIZED=true

# --- Локальный аварийный вход (на случай недоступности обоих доменов) ---
# Логин ОБЯЗАТЕЛЬНО начинается с "!" — по этому символу фронтенд отличает
# локальный вход от доменного, не пытаясь искать такой логин в LDAP.
LOCAL_ADMIN_LOGIN=!admin
LOCAL_ADMIN_PASSWORD_HASH=
# Общая аварийная учётка без прав администратора
LOCAL_USER_LOGIN=!user
LOCAL_USER_PASSWORD_HASH=

# --- Автоопределение домена по подсети клиента (вместо вкладок на логине) ---
NETWORK_DOMAIN_A_CIDR=10.148.12.0/22
NETWORK_DOMAIN_B_CIDR=192.168.254.0/23

# Сколько дней сессия остаётся активной без повторного входа (продлевается
# при каждом заходе — "rolling"). Это не настоящий SSO, а длинная сессия.
SESSION_MAX_AGE_DAYS=30

# --- Почта (Yandex 360/Почта для домена или др., внешняя аутентификация) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Служба заявок <helpdesk@lipetskstat.ru>"
