# Скопируйте этот файл в .env и задайте свои значения.
# .env не должен попадать в архивы/репозитории — там реальный пароль.

# Порт, на котором слушает сервер
PORT=3101

# Работаем ли за платформой (хелпдеском) как встроенный модуль. Пока false —
# всё работает как раньше, отдельным приложением со своим логином. Когда
# прокси на стороне платформы настроен и проверен — переключить на true:
# модуль перестанет слушать сеть напрямую (только 127.0.0.1) и перестанет
# спрашивать пароль сам, доверяя проверке платформы.
BEHIND_GATEWAY=false

# Логин и пароль для входа в веб-интерфейс (используется, только пока
# BEHIND_GATEWAY=false)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Секрет для подписи сессионных cookie — любая длинная случайная строка.
# Смените на что-то своё, например:
#   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
SESSION_SECRET=FDSAewqrdfc12e4wa4rsdafDW54234dsad
