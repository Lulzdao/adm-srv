# Скопируйте этот файл в .env и задайте свои значения.
# .env в репозиторий не коммитится — там реальные пароль и секрет.

# Порт, на котором слушает сервер
PORT=3101

# Работаем ли за платформой (хелпдеском) как встроенный модуль.
#   true  — рабочий режим в составе платформы: модуль слушает только
#           127.0.0.1 (снаружи недоступен) и не спрашивает пароль сам,
#           доверяя проверке входа и роли на стороне платформы;
#   false — автономный режим: слушает сеть и проверяет вход сам, поэтому
#           ADMIN_PASSWORD в этом случае обязателен — без него сервер не
#           запустится.
BEHIND_GATEWAY=true

# Логин и пароль для входа в веб-интерфейс. Используются, только когда
# BEHIND_GATEWAY=false. Пароль задайте свой — значения по умолчанию нет.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Секрет для подписи сессионных cookie — любая длинная случайная строка.
# Если не задать, сервер возьмёт случайный секрет на время работы процесса:
# это безопасно, но после каждого перезапуска придётся входить заново.
# Сгенерировать своё значение:
#   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
#   Node:        node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
