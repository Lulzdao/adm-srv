# В отличие от CERTVIEWER и helpdesk-backend, этот сервер НЕ читает файл .env
# сам (в server.js нет dotenv/самодельного загрузчика) — значения ниже нужно
# задать как настоящие переменные окружения процесса при запуске, например:
#   PORT=3103 JWT_SECRET="случайная-строка" npm start
# или через переменные окружения службы (NSSM/pm2/systemd). Этот файл — просто
# справка, что и зачем задавать, скопировать его в .env достаточно только для
# памяти/документации, само оно не подхватится.
#
# ВАЖНО (в отличие от CERTVIEWER и SMDR): этот процесс НЕЛЬЗЯ ограничивать
# 127.0.0.1. Через платформу (helpdesk-backend, /modules/messenger) проксируется
# только веб-панель администратора — десктоп-клиенты сотрудников (Electron)
# подключаются к этому серверу напрямую по сети (WebSocket), минуя платформу
# и её логин. Поэтому сервер должен слушать реальный сетевой адрес, как и
# раньше, просто на другом порту, чтобы не конфликтовать с helpdesk-backend
# (тот уже занимает 3000).

PORT=3103

# Секрет для подписи JWT (свои токены сервера, не связаны с сессией платформы) —
# любая длинная случайная строка.
JWT_SECRET=замените-на-случайную-строку
