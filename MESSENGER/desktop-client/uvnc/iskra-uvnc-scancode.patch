diff --git a/winvnc/winvnc/vnckeymap.cpp b/winvnc/winvnc/vnckeymap.cpp
index fdaaf9e..49c4154 100644
--- a/winvnc/winvnc/vnckeymap.cpp
+++ b/winvnc/winvnc/vnckeymap.cpp
@@ -1069,6 +1069,35 @@ void vncKeymap::keyEvent(CARD32 keysym, bool down,bool jap, bool unicode)
   key_mapper.keyEvent(keysym, down,jap, unicode);
 }
 
+// QEMU Extended Key Event. The viewer sends the physical key (XT scancode), not the character it
+// produced on the viewer machine. We map it to a virtual key with the layout of the window that has
+// the keyboard focus here, so the typed character follows THIS machine's layout: viewer RU + server
+// EN types Latin letters into a password box (with keysyms nothing was typed at all).
+void vncKeymap::scancodeEvent(CARD32 keycode, CARD32 keysym, bool down, bool jap, bool unicode)
+{
+  BYTE scan = (BYTE)(keycode & 0x7F);
+  bool extended = (keycode & 0x80) != 0;
+  if (keycode == 0 || keycode > 0xFF || scan == 0) {
+    if (keysym != 0) keyEvent(keysym, down, jap, unicode);
+    return;
+  }
+  HKL layout = GetKeyboardLayout(0);
+  HWND focus = GetForegroundWindow();
+  if (focus) {
+    DWORD tid = GetWindowThreadProcessId(focus, NULL);
+    if (tid) layout = GetKeyboardLayout(tid);
+  }
+  UINT vk = MapVirtualKeyEx(extended ? (0xE000 | scan) : scan, MAPVK_VSC_TO_VK_EX, layout);
+  if (vk == 0 || vk > 0xFF) {
+    if (keysym != 0) keyEvent(keysym, down, jap, unicode);
+    return;
+  }
+  DWORD flags = 0;
+  if (extended) flags |= KEYEVENTF_EXTENDEDKEY;
+  if (!down) flags |= KEYEVENTF_KEYUP;
+  keybd_uni_event((BYTE)vk, scan, flags, 0);
+}
+
 
 
