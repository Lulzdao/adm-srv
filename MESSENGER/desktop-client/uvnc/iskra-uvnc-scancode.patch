 inline void
+ClientConnection::SendQemuKeyEvent(DWORD keyData, bool down)
+{
+	if (m_pFileTransfer->m_fFileTransferRunning && ( m_pFileTransfer->m_fVisible || m_pFileTransfer->UsingOldProtocol())) return;
+	if (m_pTextChat->m_fTextChatRunning && m_pTextChat->m_fVisible) return;
+
+	CARD32 keycode = (keyData >> 16) & 0x7F;
+	if (keyData & 0x01000000) keycode |= 0x80; // E0-prefixed key
+	m_qemuKeyDown[keycode] = down;
+
+	rfbQemuExtendedKeyEventMsg qke;
+	memset(&qke, 0, sizeof(qke));
+	qke.type = rfbQemuEvent;
+	qke.subtype = rfbQemuExtendedKeyEvent;
+	qke.down = Swap16IfLE(down ? 1 : 0);
+	qke.keysym = 0;
+	qke.keycode = Swap32IfLE(keycode);
+	WriteExactQueue_timeout((char *)&qke, sz_rfbQemuExtendedKeyEventMsg, rfbQemuEvent, 5);
+}
+
+// Focus lost while keys are held: release them on the server, or they stay pressed there.
+void
+ClientConnection::ReleaseQemuKeys()
+{
+	for (int k = 0; k < 256; k++) {
+		if (!m_qemuKeyDown[k]) continue;
+		m_qemuKeyDown[k] = false;
+		rfbQemuExtendedKeyEventMsg qke;
+		memset(&qke, 0, sizeof(qke));
+		qke.type = rfbQemuEvent;
+		qke.subtype = rfbQemuExtendedKeyEvent;
+		qke.down = 0;
+		qke.keycode = Swap32IfLE((CARD32)k);
+		WriteExactQueue_timeout((char *)&qke, sz_rfbQemuExtendedKeyEventMsg, rfbQemuEvent, 5);
+	}
+}
