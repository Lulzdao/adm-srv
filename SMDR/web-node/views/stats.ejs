<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8"><title>Статистика</title>
<link rel="stylesheet" href="style.css">
<!-- Тема «Центра»: файлы платформы. Открыт напрямую — их нет, остаётся голубая. -->
<script src="/theme.js"></script><link rel="stylesheet" href="/themes.css">
<script src="vendor/chart.umd.js"></script>
</head><body>
<div class="container">

<div class="cards">
  <div class="card total"><div class="num"><%= total %></div><div class="label">Всего</div></div>
  <div class="card out"><div class="num"><%= outCount %></div><div class="label">Исходящие</div></div>
  <div class="card in"><div class="num"><%= inCount %></div><div class="label">Входящие</div></div>
  <div class="card internal"><div class="num"><%= intCount %></div><div class="label">Внутренние</div></div>
</div>

<h1 style="margin-top:30px">Звонки по дням</h1>
<canvas id="dailyChart" height="50"></canvas>
<h1 style="margin-top:30px">Минуты разговоров по дням</h1>
<canvas id="minutesChart" height="50"></canvas>

<h1 style="margin-top:30px">Сводка</h1>
<form class="filters" id="tableFilterForm">
  <div><label>Дата от</label><input type="date" name="date_from"></div>
  <div><label>Дата до</label><input type="date" name="date_to"></div>
  <div><button type="submit">Применить</button></div>
  <div><a href="#" class="btn-reset" id="tableReset">Сброс</a></div>
</form>
<table>
<thead>
<tr>
  <th class="sortable" data-sort="ext">Внутренний</th>
  <th class="sortable" data-sort="fio">Сотрудник</th>
  <th class="sortable" data-sort="total">Всего</th>
  <th class="sortable" data-sort="outgoing">Исходящие</th>
  <th class="sortable" data-sort="incoming">Входящие</th>
  <th class="sortable" data-sort="internal">Внутренние</th>
  <th class="sortable" data-sort="outgoingSeconds">Минуты исходящих</th>
</tr>
</thead>
<tbody id="summaryBody"></tbody>
</table>
</div>

<script>
// Сводная таблица ниже собирается через innerHTML, поэтому значения из базы
// (в первую очередь ФИО из справочника — его вводит человек) экранируем.
function escHtml(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}
// Подписи и сетка графиков — в цветах темы «Центра» (переменные из themes.css платформы): иначе в
// тёмной теме серые подписи Chart.js почти не видны. Открыто напрямую, без темы, — прежние цвета.
// Цвета столбцов — те же, что у точек на чипах «Направление» в журнале (--dir-… в style.css):
// фирменные голубой, изумрудный и сиреневый, в тёмной теме — их светлые тона.
const DIR_COLORS = {};
function applyChartTheme() {
  const css = getComputedStyle(document.documentElement);
  const v = (name, fallback) => (css.getPropertyValue(name) || '').trim() || fallback;
  Chart.defaults.color = v('--md-on-surface-variant', '#666');
  Chart.defaults.borderColor = v('--md-outline', 'rgba(0, 0, 0, 0.1)');
  DIR_COLORS.outgoing = v('--dir-outgoing', '#0A61AE');
  DIR_COLORS.incoming = v('--dir-incoming', '#008F9F');
  DIR_COLORS.internal = v('--dir-internal', '#663AB5');
  Object.values(Chart.instances).forEach(function (c) {
    c.data.datasets.forEach(function (ds) { if (ds.dir) ds.backgroundColor = DIR_COLORS[ds.dir]; });
  });
}
applyChartTheme();
// Тему сменили в «Центре» — theme.js (подключён выше) уже переставил атрибут; перерисовываем графики.
window.addEventListener('storage', function (e) {
  if (e.key && e.key.indexOf('center.theme') !== 0) return;
  setTimeout(function () {
    applyChartTheme();
    Object.values(Chart.instances).forEach(function (c) { c.update(); });
  }, 0);
});

fetch('api/stats/daily').then(r => r.json()).then(data => {
  const days = [...new Set(data.map(d => d.day))].sort();
  const dirs = ['outgoing', 'incoming', 'internal'];
  const datasets = dirs.map(dir => ({
    label: dir === 'outgoing' ? 'Исходящие' : dir === 'incoming' ? 'Входящие' : 'Внутренние',
    data: days.map(day => (data.find(d => d.day === day && d.direction === dir) || {}).cnt || 0),
    dir: dir,
    backgroundColor: DIR_COLORS[dir]
  }));
  new Chart(document.getElementById('dailyChart'), {
    type: 'bar',
    data: { labels: days, datasets },
    options: {
      responsive: true,
      scales: { x: { stacked: true }, y: { stacked: true, title: { display: true, text: 'звонки' } } }
    }
  });
});
fetch('api/stats/daily-minutes').then(r => r.json()).then(data => {
  const days = [...new Set(data.map(d => d.day))].sort();
  const dirs = ['outgoing', 'incoming'];
  const datasets = dirs.map(dir => ({
    label: dir === 'outgoing' ? 'Исходящие' : 'Входящие',
    data: days.map(day => (data.find(d => d.day === day && d.direction === dir) || {}).minutes || 0),
    dir: dir,
    backgroundColor: DIR_COLORS[dir]
  }));
  new Chart(document.getElementById('minutesChart'), {
    type: 'bar',
    data: { labels: days, datasets },
    options: {
      responsive: true,
      scales: { x: { stacked: true }, y: { stacked: true, title: { display: true, text: 'минуты' } } }
    }
  });
});
function formatMinutes(sec) {
  const m = Math.round(sec / 60);
  return `${m} мин`;
}

let summaryData = [];
let sortField = 'outgoingSeconds';
let sortDir = 'desc';

function renderSummary() {
  const sorted = [...summaryData].sort((a, b) => {
    let av = a[sortField], bv = b[sortField];
    if (sortField === 'ext' || sortField === 'fio') {
      av = (av || '').toString().toLowerCase();
      bv = (bv || '').toString().toLowerCase();
      return sortDir === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
    }
    av = av || 0; bv = bv || 0;
    return sortDir === 'asc' ? av - bv : bv - av;
  });

  if (!sorted.length) {
    document.getElementById('summaryBody').innerHTML =
      '<tr class="empty-row"><td class="empty-state" colspan="7">За выбранный период звонков нет.</td></tr>';
  } else document.getElementById('summaryBody').innerHTML = sorted.map(row => `
    <tr>
      <td>${escHtml(row.ext)}</td>
      <td>${row.fio ? escHtml(row.fio) : '—'}</td>
      <td>${Number(row.total) || 0}</td>
      <td>${Number(row.outgoing) || 0}</td>
      <td>${Number(row.incoming) || 0}</td>
      <td>${Number(row.internal) || 0}</td>
      <td>${escHtml(formatMinutes(row.outgoingSeconds))}</td>
    </tr>`).join('');

  document.querySelectorAll('th.sortable').forEach(th => {
    th.classList.remove('sort-asc', 'sort-desc');
    if (th.dataset.sort === sortField) th.classList.add(sortDir === 'asc' ? 'sort-asc' : 'sort-desc');
  });
}

document.querySelectorAll('th.sortable').forEach(th => {
  th.addEventListener('click', () => {
    const field = th.dataset.sort;
    if (sortField === field) {
      sortDir = sortDir === 'asc' ? 'desc' : 'asc';
    } else {
      sortField = field;
      sortDir = field === 'ext' || field === 'fio' ? 'asc' : 'desc';
    }
    renderSummary();
  });
});

function loadSummary() {
  const params = new URLSearchParams(new FormData(document.getElementById('tableFilterForm')));
  fetch('api/stats/table?' + params.toString()).then(r => r.json()).then(data => {
    summaryData = data;
    sortField = 'outgoingSeconds';
    sortDir = 'desc';
    renderSummary();
  });
}

document.getElementById('tableFilterForm').addEventListener('submit', function(e) {
  e.preventDefault();
  loadSummary();
});
document.getElementById('tableReset').addEventListener('click', function(e) {
  e.preventDefault();
  document.getElementById('tableFilterForm').reset();
  loadSummary();
});

loadSummary();

</script>
<script src="select.js"></script>
</body></html>