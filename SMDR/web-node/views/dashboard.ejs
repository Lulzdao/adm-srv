<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8"><title>Журнал звонков</title>
<link rel="stylesheet" href="style.css"></head>
<body class="dashboard-page">
<div class="container">

<%- include('_filters') %>

<div class="pagination">
  <div class="pagination-controls">
    <% if (prevUrl) { %><a href="<%= prevUrl %>" class="page-btn">← Назад</a>
    <% } else { %><span class="page-btn disabled">← Назад</span><% } %>
    <span class="page-info" id="pageInfo">Страница <%= page %> из <%= totalPages %> · всего <%= filteredTotal %> звонков</span>
    <% if (nextUrl) { %><a href="<%= nextUrl %>" class="page-btn">Вперёд →</a>
    <% } else { %><span class="page-btn disabled">Вперёд →</span><% } %>
  </div>
</div>

<div class="table-wrap">
  <table id="callsTable">
  <thead>
  <tr>
    <th>Дата</th><th>Время</th><th>Внутренний</th><th>Направление</th><th>Детали</th>
    <th>Длительность</th><th>Ожидание</th><th>Сотрудник</th>
  </tr>
  </thead>
  <tbody id="callsBody">
  <%- include('_rows', { rows }) %>
  </tbody>
  </table>
</div>

</div>

<script>
// Таблица дособирается на клиенте через innerHTML, поэтому всё, что пришло из
// базы, обязано экранироваться здесь вручную — на сервере EJS (<%= %>) делает
// это сам, а тут защиты не было: ФИО из справочника (его вводит человек) и
// поля звонка от АТС попадали в разметку как есть.
function escHtml(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}
function cell(value) {
  return value === null || value === undefined || value === '' ? '—' : escHtml(value);
}
function directionCell(row) {
  if (row.direction === 'incoming') return escHtml(row.caller || '') + ' → ' + escHtml(row.did || '');
  if (row.direction === 'internal') return '→ ' + escHtml(row.internal_to || '');
  if (row.direction === 'outgoing') return escHtml(row.number || '');
  return '<span class="muted">не распознано</span>';
}
function badgeCell(row) {
  if (row.direction === 'incoming' && row.status === 'NA') return '<span class="badge missed">Пропущенный</span>';
  if (row.direction === 'outgoing') return '<span class="badge outgoing">Исходящий</span>';
  if (row.direction === 'incoming') return '<span class="badge incoming">Входящий</span>';
  if (row.direction === 'internal') return '<span class="badge internal">Внутренний</span>';
  return '<span class="badge unknown">?</span>';
}
function renderRows(rows) {
  return rows.map(function(row) {
    return '<tr>' +
      '<td>' + cell(row.call_date) + '</td>' +
      '<td>' + cell(row.call_time) + '</td>' +
      '<td>' + cell(row.ext) + '</td>' +
      '<td>' + badgeCell(row) + '</td>' +
      '<td>' + directionCell(row) + '</td>' +
      '<td>' + cell(row.duration) + '</td>' +
      '<td>' + cell(row.ring) + '</td>' +
      '<td>' + cell(row.fio) + '</td>' +
    '</tr>';
  }).join('');
}

async function refreshData() {
  const params = new URLSearchParams(new FormData(document.getElementById('filterForm')));
  let data;
  try {
    const res = await fetch('api/calls?' + params.toString());
    if (!res.ok) return;
    data = await res.json();
  } catch (e) {
    return;
  }
  document.getElementById('callsBody').innerHTML = renderRows(data.rows);
  document.getElementById('pageInfo').textContent =
  'Страница ' + data.page + ' из ' + data.totalPages + ' · всего ' + data.filteredTotal + ' звонков';
  syncExportLabel(data.filteredTotal);
  document.getElementById('lastUpdate').textContent = 'обновлено ' + new Date().toLocaleTimeString('ru-RU');
}

let refreshTimer = null;
function startAutoRefresh() { refreshTimer = setInterval(refreshData, 5000); }
function stopAutoRefresh() { clearInterval(refreshTimer); }
document.getElementById('filterForm').addEventListener('submit', function() {
  document.getElementById('pageInput').value = 1; // при новом фильтре начинаем с первой страницы
});
document.getElementById('autoRefresh').addEventListener('change', function(e) {
  if (e.target.checked) startAutoRefresh(); else stopAutoRefresh();
});

startAutoRefresh();

// ---------------------------------------------------------------------------
//  Фильтры: переключатели направления и раскрывающийся ряд
// ---------------------------------------------------------------------------

var dirInput = document.getElementById('dirInput');
var chips = [].slice.call(document.querySelectorAll('.dir-chip'));

function syncDirections() {
  dirInput.value = chips.filter(function (c) { return c.classList.contains('on'); })
    .map(function (c) { return c.dataset.dir; }).join(',');
}
chips.forEach(function (c) {
  c.addEventListener('click', function () { c.classList.toggle('on'); syncDirections(); });
});

var moreBtn = document.getElementById('moreBtn');
var moreRow = document.getElementById('moreRow');
moreBtn.addEventListener('click', function () {
  var open = moreRow.classList.toggle('open');
  moreBtn.classList.toggle('open', open);
  moreBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
});

// ---------------------------------------------------------------------------
//  Выгрузка в CSV
//
//  Окно предлагает несколько периодов и рядом с каждым пишет, сколько строк
//  уедет и сколько это весит. Это и есть подтверждение: отдельного вопроса
//  «точно выгружать?» нет, а если в базе годы, а нужен последний месяц,
//  период выбирается прямо здесь, без возврата к фильтрам.
// ---------------------------------------------------------------------------

var PERIOD_LABELS = [
  ['current', 'Текущая выборка'],
  ['month', 'За последний месяц'],
  ['quarter', 'За последний квартал'],
  ['year', 'За последний год'],
  ['all', 'Весь журнал'],
];
// Выше этого числа строк рядом с вариантом появляется предупреждение: Excel
// такой файл откроет, но заметно подумает. Значок только у тяжёлых вариантов —
// на каждой строке он перестал бы что-либо значить.
var HEAVY_ROWS = 100000;

var modal = document.getElementById('exportModal');
var optionsBox = document.getElementById('exportOptions');
var chosenPeriod = 'current';
// По умолчанию .xlsx: в нём номер +74951234567 остаётся номером, а в CSV его
// приходится обезвреживать апострофом, иначе Excel считает ячейку формулой.
var chosenFormat = 'xlsx';
var lastPreview = null;

var FORMAT_NOTE = {
  xlsx: 'Готовая книга: шапка закреплена, включён автофильтр, номера не превращаются в формулы.',
  csv: 'Простой текст, открывается везде. Номера вида +7495… Excel считает формулами, поэтому перед ними ставится апостроф.'
};

function formatRows(n) {
  return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
}
function formatBytes(b) {
  if (b < 1024 * 1024) return Math.max(1, Math.round(b / 1024)) + ' КБ';
  return (b / 1024 / 1024).toFixed(b < 10 * 1024 * 1024 ? 1 : 0).replace('.', ',') + ' МБ';
}
function filterParams() {
  var p = new URLSearchParams(new FormData(document.getElementById('filterForm')));
  p.delete('page');
  return p;
}

var WARN_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"'
  + ' stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
  + '<path d="M12 3l9.5 17H2.5L12 3z"/><line x1="12" y1="10" x2="12" y2="14"/>'
  + '<line x1="12" y1="17" x2="12" y2="17"/></svg>';

function bytesOf(info) {
  // Сервер присылает оба размера: XML сжимается сильнее, чем текст с
  // кириллическими ФИО, и на глаз это не угадать.
  if (info.bytes && typeof info.bytes === 'object') return info.bytes[chosenFormat] || 0;
  return info.bytes || 0;   // старый ответ без разбивки по форматам
}

function renderOptions(preview) {
  lastPreview = preview;
  optionsBox.innerHTML = PERIOD_LABELS.map(function (pair) {
    var id = pair[0];
    var info = preview[id] || { rows: 0, bytes: 0 };
    var heavy = info.rows >= HEAVY_ROWS;
    return '<button type="button" class="opt' + (id === chosenPeriod ? ' on' : '') + '" data-period="' + id + '">'
      + '<span class="radio"></span>'
      + '<span class="name">' + escHtml(pair[1]) + '</span>'
      + '<span class="size' + (heavy ? ' warn' : '') + '">' + (heavy ? WARN_ICON : '')
      + formatRows(info.rows) + ' ' + plural(info.rows, 'строка', 'строки', 'строк')
      + ' · ~' + formatBytes(bytesOf(info)) + '</span></button>';
  }).join('');
  [].slice.call(optionsBox.querySelectorAll('.opt')).forEach(function (o) {
    o.addEventListener('click', function () {
      chosenPeriod = o.dataset.period;
      [].slice.call(optionsBox.querySelectorAll('.opt')).forEach(function (x) {
        x.classList.toggle('on', x === o);
      });
    });
  });
}

function plural(n, one, few, many) {
  var m100 = n % 100, m10 = n % 10;
  if (m100 >= 11 && m100 <= 14) return many;
  if (m10 >= 2 && m10 <= 4) return few;
  if (m10 === 1) return one;
  return many;
}

function syncFormat() {
  [].slice.call(document.querySelectorAll('.fmt')).forEach(function (b) {
    b.classList.toggle('on', b.dataset.fmt === chosenFormat);
  });
  document.getElementById('fmtNote').textContent = FORMAT_NOTE[chosenFormat];
  // Размеры пересчитываем на месте, не спрашивая сервер заново.
  if (lastPreview) renderOptions(lastPreview);
}
[].slice.call(document.querySelectorAll('.fmt')).forEach(function (b) {
  b.addEventListener('click', function () { chosenFormat = b.dataset.fmt; syncFormat(); });
});
syncFormat();

document.getElementById('exportBtn').addEventListener('click', function () {
  chosenPeriod = 'current';
  lastPreview = null;
  optionsBox.innerHTML = '<p class="note" style="margin:0 0 8px;">Считаем…</p>';
  modal.hidden = false;
  fetch('api/export/preview?' + filterParams().toString())
    .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error(r.status)); })
    .then(renderOptions)
    .catch(function () {
      optionsBox.innerHTML = '<p class="note" style="margin:0 0 8px;">Не удалось посчитать строки. '
        + 'Выгрузка текущей выборки всё равно доступна.</p>';
    });
});

function closeModal() { modal.hidden = true; }
document.getElementById('exportCancel').addEventListener('click', closeModal);
// Щелчок мимо окна и Esc закрывают его: окно ничего не меняет, и запирать
// человека в нём незачем.
modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) closeModal(); });

document.getElementById('exportGo').addEventListener('click', function () {
  var p = filterParams();
  p.set('period', chosenPeriod);
  // Скачивание через временную ссылку, а не сменой location: страница живёт
  // в iframe внутри платформы, и переводить сам кадр на файл незачем.
  var a = document.createElement('a');
  a.href = 'export.' + chosenFormat + '?' + p.toString();
  a.download = '';
  document.body.appendChild(a);
  a.click();
  a.remove();
  closeModal();
});

// Число строк на кнопке выгрузки — то же, что показывает счётчик страниц.
function syncExportLabel(total) {
  document.getElementById('exportLabel').textContent =
    'Выгрузить ' + formatRows(total) + ' ' + plural(total, 'строку', 'строки', 'строк');
}
syncExportLabel(<%= filteredTotal %>);
</script>
<script src="select.js"></script>
</body></html>
