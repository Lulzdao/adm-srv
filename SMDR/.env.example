# Настройки сборщика Collector.Py. Скопируйте этот файл в .env рядом с ним
# и подставьте свои значения — .env в репозиторий не коммитится.
#
# Раньше адрес АТС и пароль SMDR были прописаны прямо в Collector.Py и
# попадали в репозиторий вместе с кодом. Теперь сборщик без этих значений
# просто не стартует.

# Адрес и порт АТС Panasonic KX-TDE200 (порт вывода SMDR по TCP)
SMDR_HOST=10.0.0.1
SMDR_PORT=23000

# Учётные данные SMDR-сессии на АТС (Maintenance Console → SMDR Options).
# У Panasonic заводской пароль общеизвестен и описан в документации к АТС —
# если его ни разу не меняли, смените на АТС и укажите здесь новый.
SMDR_LOGIN=SMDR
SMDR_PASSWORD=

# --- Обнаружение «тихого» обрыва связи с АТС ---
# Записи приходят только по завершении разговора, поэтому тишина — не поломка.
# Раз в SMDR_IDLE_NOTE_MIN минут молчания коллектор отмечает в логе, что связь
# держит; после SMDR_IDLE_RECONNECT_MIN минут переподключается на случай, если
# соединение оборвалось незаметно (0 — не переподключаться никогда).
SMDR_IDLE_NOTE_MIN=5
SMDR_IDLE_RECONNECT_MIN=30
